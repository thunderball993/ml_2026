   "source": [
    "var_plot1 = \"Temperature_C\"\n",
    "var_plot2 = \"CO2_tCO2_\"\n",
    "\n",
    "df_energy[\"DateTime\"] = pd.to_datetime(df_energy[\"date\"], format=\"%d/%m/%Y %H:%M\")\n",
    "df_plot = df_energy.sort_values(\"DateTime\")\n",
    "\n",
    "fig, axes = plt.subplots(2, 1, figsize=(11, 6), sharex=True)\n",
