    "    ax.plot(df_plot[\"DateTime\"], df_plot[name], linewidth=0.4)\n",
    "    ax.set_ylabel(name, fontsize=9)\n",
    "    ax.grid(True)\n",
    "axes[-1].set_xlabel(\"Время\")\n",
    "axes[0].set_title(\"Итоговый набор данных\")\n",
